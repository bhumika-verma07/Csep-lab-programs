#include <iostream>
using namespace std;

int main()
{
    char str[100];

    cout << "Enter a string: ";
    cin.getline(str, 100);

    int size = 0;

    while (str[size] != '\0')
    {
        size++;
    }

    cout << "Reverse of string: ";

    for (int i = size - 1; i >= 0; i--)
    {
        cout << str[i];
    }

    return 0;
}